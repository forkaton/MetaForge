CREATE TABLE HeroEntity (
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    lane TEXT NOT NULL,
    role TEXT NOT NULL,
    imageUrl TEXT NOT NULL,
    iconUrl TEXT NOT NULL,
    specialty TEXT NOT NULL
);

selectAllHeroes:
SELECT * FROM HeroEntity;

insertHero:
INSERT OR REPLACE INTO HeroEntity(id, name, lane, role, imageUrl, iconUrl, specialty)
VALUES (?, ?, ?, ?, ?, ?, ?);

deleteAllHeroes:
DELETE FROM HeroEntity;